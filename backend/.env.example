# Database
DATABASE_ENABLED=false
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/legal_metrology_db

# Application
APP_NAME=Legal Metrology Compliance Checker
APP_VERSION=1.0.0-prod
DEBUG=false
PORT=8000

# CORS & Networking
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=

# File paths
UPLOAD_DIR=uploads
REPORT_DIR=generated_reports

# OCR & Classification
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.5
CATEGORY_CONFIDENCE_THRESHOLD=0.6

# Performance & Memory Optimization
MAX_OCR_IMAGE_DIMENSION=1536
MAX_IMAGES_PER_INSPECTION=8
OCR_CONCURRENCY=1
PADDLE_CPU_THREADS=1

# Upload Limits
MAX_UPLOAD_SIZE_MB=15

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Gemini LLM Semantic Evidence Resolver
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MIN_CONFIDENCE=0.80
GEMINI_AUTO_SCOPE=true

# Automatic Image Quality Gate (Pre-OCR deterministic quality check)
IMAGE_QUALITY_GATE_ENABLED=true
IMAGE_QUALITY_BLUR_WARN_THRESHOLD=75.0
IMAGE_QUALITY_BLUR_REJECT_THRESHOLD=35.0
IMAGE_QUALITY_MIN_WIDTH=320
IMAGE_QUALITY_MIN_HEIGHT=320
IMAGE_QUALITY_MIN_PIXELS=150000
IMAGE_QUALITY_DARK_WARN_RATIO=0.60
IMAGE_QUALITY_DARK_REJECT_RATIO=0.85
IMAGE_QUALITY_DARK_MEAN_THRESHOLD=45.0
IMAGE_QUALITY_OVEREXPOSE_WARN_RATIO=0.35
IMAGE_QUALITY_OVEREXPOSE_REJECT_RATIO=0.60
IMAGE_QUALITY_GLARE_WARN_RATIO=0.05
IMAGE_QUALITY_GLARE_REJECT_RATIO=0.18
IMAGE_QUALITY_LOW_CONTRAST_WARN=25.0
IMAGE_QUALITY_LOW_CONTRAST_REJECT=12.0


